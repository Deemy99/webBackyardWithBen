{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/articles/gardening-mistakes.html",
      "destination": "/guides/gardening-mistakes-time-money-blooms",
      "statusCode": 301
    },
    {
      "source": "/articles",
      "destination": "/guides",
      "statusCode": 301
    },
    {
      "source": "/projects",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/projects/:path*",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/blogs.html",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/affiliate-disclosure.html",
      "destination": "/disclosure",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/articles/view.html",
      "destination": "/api/legacy-article"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ]
}
